# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saude_ocupacional
DB_USER=postgres
DB_PASSWORD=micro123

# Servidor
SERVER_PORT=8080

# JWT — TROQUE EM PRODUÇÃO para um secret de 64+ chars aleatórios
# Gere com: openssl rand -hex 64  (ou python3 -c "import secrets; print(secrets.token_hex(64))")
JWT_SECRET=3f7a9b2e1d4c8f6a5e3b7d9c2a0f4e8b1c6d3a7f5e2b9d4c8a1f6e3b0d7c4a9e2f5b8c1d4a7e0b3c6f9a2d5e8b1c4f7a0d3e6b9c2f5a8d1e4b7c0a3f6d9e2b5c8a1f4d7e0b3c6f9
JWT_EXPIRATION=28800000

# CORS — URLs permitidas (separadas por vírgula)
CORS_ORIGINS=http://localhost:8080,http://192.168.100.42:8080

# Admin — senha do primeiro acesso (troque imediatamente após login!)
ADMIN_PASSWORD=Admin@Dev2026

# Perfil Spring (dev não ativa prod.properties)
SPRING_PROFILES_ACTIVE=dev

# Logs
LOGS=./logs